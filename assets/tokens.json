{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "diffuse product palette. Dark-only by design: the brand accent is a high-luminance acid yellow-green that is legible on ink and invisible on light surfaces.",
  "color": {
    "neutral": {
      "ink": { "$value": "#0C0C11", "$type": "color", "$description": "App canvas. Violet-black, tinted toward hue 248.5deg — 5.4deg from the exact complement of brand.acid. At this lightness 8-bit rounding quantizes it to 240deg; the tint reads more precisely on the raised steps." },
      "surfaceSoft": { "$value": "#131219", "$type": "color", "$description": "Lowest raised step. Rows, inset wells, ghost buttons." },
      "graphite": { "$value": "#1B1A23", "$type": "color", "$description": "Raised surface / cards. Measures hue 246.7deg, 3.6deg from the exact complement of brand.acid; this is where the tint reads most clearly." },
      "border": { "$value": "#2C2A37", "$type": "color", "$description": "Hairlines and card outlines." },
      "fog": { "$value": "#A7A7A3", "$type": "color", "$description": "Muted text." },
      "bone": { "$value": "#F2F1EA", "$type": "color", "$description": "Primary text." }
    },
    "brand": {
      "acid": { "$value": "#F0FB28", "$type": "color", "$description": "The single diffuse accent. Brand, primary action, and active status all collapse onto this." },
      "logoInk": { "$value": "#000000", "$type": "color", "$description": "Fixed logo ink. Pure black, not neutral.ink — locked in by the raster avatar export." }
    },
    "semantic": {
      "surfaceCanvas": { "$value": "{color.neutral.ink}", "$type": "color" },
      "surfaceRaised": { "$value": "{color.neutral.graphite}", "$type": "color" },
      "surfaceInset": { "$value": "{color.neutral.surfaceSoft}", "$type": "color" },
      "borderDefault": { "$value": "{color.neutral.border}", "$type": "color" },
      "textPrimary": { "$value": "{color.neutral.bone}", "$type": "color" },
      "textMuted": { "$value": "{color.neutral.fog}", "$type": "color" },
      "actionPrimary": { "$value": "{color.brand.acid}", "$type": "color" },
      "statusActive": { "$value": "{color.brand.acid}", "$type": "color" }
    }
  },
  "contrast": {
    "$description": "Measured WCAG contrast for brand.acid (#F0FB28, relative luminance 0.877). Use only on ink or black.",
    "acidOnInk": { "$value": "17.2:1", "$type": "string" },
    "acidOnGraphite": { "$value": "15.2:1", "$type": "string" },
    "acidOnBlack": { "$value": "18.5:1", "$type": "string" },
    "boneOnInk": { "$value": "17.2:1", "$type": "string" },
    "fogOnInk": { "$value": "8.1:1", "$type": "string" },
    "acidOnBone": { "$value": "1.00:1", "$type": "string", "$description": "FAILS. Never place acid on a light surface as a foreground." },
    "acidOnWhite": { "$value": "1.13:1", "$type": "string", "$description": "FAILS. Never place acid on a light surface as a foreground." }
  },
  "radius": {
    "none": { "$value": "0px", "$type": "dimension" },
    "xs": { "$value": "6px", "$type": "dimension" },
    "sm": { "$value": "12px", "$type": "dimension" },
    "md": { "$value": "20px", "$type": "dimension" },
    "lg": { "$value": "32px", "$type": "dimension" },
    "xl": { "$value": "44px", "$type": "dimension" },
    "full": { "$value": "999px", "$type": "dimension" }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "240ms", "$type": "duration" },
      "slow": { "$value": "480ms", "$type": "duration" }
    },
    "easing": {
      "intuitive": { "$value": [0.22, 1, 0.36, 1], "$type": "cubicBezier" }
    }
  }
}
