# --- REQUIRED: Compose will not start until these are set ---
# POSTGRES_PASSWORD  - blocks `docker compose up` while empty
# REVIEW_MODEL       - required only for transitional REVIEW_RUNTIME=litellm
# ANTHROPIC_API_KEY  - required only by an Anthropic LiteLLM model
# Plus the Diffuse-Agent enrollment values below. The shared GitHub App key and
# webhook secret remain at api.diffuse.website, never in this deployment.
# Everything else in this file has a working default.

# Docker Compose database password. Generate a URL-safe value, for example
# `openssl rand -hex 32`. Compose refuses to start while this is empty.
#
# ROTATING THIS IS NOT A CONFIGURATION CHANGE. PostgreSQL reads POSTGRES_PASSWORD
# only when it initialises an empty data directory; on every later start it is
# ignored. But the same value is interpolated into DATABASE_URL, so editing it
# against an existing pgdata volume leaves the stored password untouched and
# breaks authentication for app, worker and migrate at once. To actually rotate:
# change the password inside PostgreSQL first
# (`docker compose exec db psql -U diffuse -c "ALTER ROLE diffuse PASSWORD '...'"`),
# then update this file and restart. Deleting the volume also works and destroys
# every index and review.
POSTGRES_PASSWORD=

# Model providers and source-control integrations
# Required only when REVIEW_MODEL (or CODE_QUERY_MODEL, or REVIEW_VERIFIER_MODEL)
# names an OpenAI model. Retrieval is graph and lexical search inside PostgreSQL,
# so indexing needs no model credential at all.
OPENAI_API_KEY=
# Required by the REVIEW_MODEL recommended below: any REVIEW_MODEL starting with
# `anthropic/` or `claude-` resolves this key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Alternate name for the same Google credential; GEMINI_API_KEY wins when both
# are set. Resolved for `gemini/`, `google/`, and bare `gemini-` identifiers.
GOOGLE_API_KEY=
# Resolved for `azure/` and `azure_ai/` identifiers. Azure OpenAI also needs
# AZURE_API_BASE and AZURE_API_VERSION, which LiteLLM reads from the ambient
# environment rather than through Diffuse's provider table.
AZURE_API_KEY=
# One gateway credential can serve both configured review families. With
# LiteLLM, use model IDs such as openrouter/anthropic/claude-sonnet-4.6.
OPENROUTER_API_KEY=
# Recommended: enroll this instance with the shared Diffuse-Agent GitHub App.
# After the browser setup flow, run:
#   diffuse hosted enroll <one-time-code> --name <this-instance-name>
# Copy the four secret values it prints here. This deployment polls outward to
# the hosted relay; it needs no public inbound webhook URL and never receives
# the shared App private key. The same instance token is used only to obtain a
# short-lived, installation-scoped GitHub token and to pull its own events.
DIFFUSE_HOSTED_RELAY_URL=https://api.diffuse.website
DIFFUSE_HOSTED_TOKEN_BROKER_URL=https://api.diffuse.website
DIFFUSE_HOSTED_INSTANCE_TOKEN=
DIFFUSE_HOSTED_EVENT_SIGNING_KEY=
DIFFUSE_HOSTED_RELAY_POLL_SECONDS=15

# Advanced standalone alternative: authenticate with an App you operate
# yourself. Do not configure these alongside DIFFUSE_HOSTED_TOKEN_BROKER_URL.
# GITHUB_APP_ID accepts the App client ID or numeric App ID.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Prefer a read-only file mounted only into app and worker. If a secret manager
# injects environment variables, set GITHUB_APP_PRIVATE_KEY instead; literal
# `\n` sequences are converted back into PEM newlines. The file wins when both
# are set. Never commit the PEM.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_PRIVATE_KEY=
# Backward-compatible static bearer-token fallback. Leave this empty when using
# either GitHub App mode above.
GITHUB_TOKEN=
# Used only by the advanced standalone App webhook endpoint. Leave empty for
# the shared Diffuse-Agent flow.
GITHUB_WEBHOOK_SECRET=
# Override both URLs together for GitHub Enterprise Server.
GITHUB_WEB_URL=https://github.com
GITHUB_API_URL=https://api.github.com
# Optional exact comma-separated origins that may receive the resolved GitHub
# credential during clone/fetch. The primary GITHUB_WEB_URL is always allowed.
GITHUB_ALLOWED_INSTANCES=
# Optional for GitHub Enterprise Server; defaults to the public endpoint or is
# derived from an API URL ending in /api/v3.
GITHUB_GRAPHQL_URL=
GITHUB_API_VERSION=2026-03-10


# Diffuse
# Compose normally loads this copied file as `.env`. Override only for
# configuration validation or a secret-manager-generated environment file.
DIFFUSE_ENV_FILE=.env
# Release bundles pin these to the matching runner digests. Development Compose
# supplies local defaults when they are unset.
DIFFUSE_CLAUDE_RUNNER_IMAGE=
DIFFUSE_CODEX_RUNNER_IMAGE=
# Used by commands run directly on the host. Replace the password with the
# URL-safe POSTGRES_PASSWORD below. Compose supplies its own container URL.
DATABASE_URL=postgresql://diffuse:diffuse-dev@localhost:5432/diffuse
DIFFUSE_PUBLIC_URL=http://localhost:8000
# Every configured origin receives a clone credential, so https is required off
# loopback. Set to 1 only for a lab instance where plaintext to a non-loopback
# host is acceptable.
DIFFUSE_ALLOW_PLAINTEXT_ORIGINS=0
# Retrieved repository context budget. The formatted context block is built once
# and then repeated verbatim into every review call, so the prompt-token cost of
# raising these is multiplied by REVIEW_PASSES x REVIEW_MAX_DIFF_CHUNKS: at the
# defaults below that is 4 passes x up to 8 chunks = up to 32 calls carrying
# ~6k context tokens each (~192k tokens); a typical single-chunk pull request
# costs ~24k tokens. Treat both as lower bounds rather than a quote: they were
# measured on openai/gpt-4.1-mini, and current frontier models tokenize the same
# text into noticeably more tokens and bill adaptive thinking at output rates.
# On an Anthropic model that repetition is cached rather than re-billed: context
# and policy are sent as one cacheable prefix ahead of the diff, so the 32 calls
# become 4 cache writes -- one per pass, because the system prompt differs per
# pass -- and 28 reads at roughly a tenth of the input rate. The figures above
# are what an uncached route still pays, and openai/gpt-4.1-mini is one.
# Measure your own repositories before budgeting. Lower
# MAX_CONTEXT_CHARS first if reviews get expensive - it binds before the chunk
# count whenever chunks are large. MAX_CONTEXT_CHUNKS must be 1-20; above 20 the
# fusion stage is already selecting from an exhausted candidate pool. Both are
# validated at startup, so a malformed value fails fast instead of per review.
MAX_CONTEXT_CHUNKS=18
MAX_CONTEXT_CHARS=24000
# Required only for transitional REVIEW_RUNTIME=litellm. There is no built-in
# default: Diffuse will not assume you hold a credential for a provider you
# never named. CLI-native REVIEW_RUNTIME=codex or claude uses the isolated
# runner logins instead and leaves this unset.
# The value below is a recommendation, not a fallback -- edit it freely.
#
# anthropic/claude-sonnet-5 is a good starting point: strong bug-finding, 1M
# context to match the retrieval budget above, $3/$15 per million input/output
# tokens. Cheaper alternatives, in order: anthropic/claude-haiku-4-5 ($1/$5,
# 200K context), or openai/gpt-4.1-mini (needs only OPENAI_API_KEY). For maximum
# depth on high-stakes repositories use anthropic/claude-opus-4-8 ($5/$25). To
# keep review traffic inside your own infrastructure, set a self-hosted route
# here (for example ollama/<model> or litellm_proxy/<model>) together with
# REVIEW_API_BASE below; a managed `anthropic/` route ignores REVIEW_API_BASE
# by design.
#
# Shipped commented out on purpose. A `cp .env.example .env` that produces a
# working review model is a default by another name -- the same guess the code
# default was deleted for, moved into a file. Uncomment the line below, or
# replace it, and Diffuse will tell you at startup if you select `litellm`.
#REVIEW_MODEL=anthropic/claude-sonnet-5
# Optional independent verifier. Configure a different family to let Diffuse
# route Claude-authored changes to OpenAI, OpenAI-authored changes to Claude,
# and ambiguous Cursor/Copilot changes through cross-family verification.
REVIEW_VERIFIER_MODEL=
REVIEW_PROVENANCE_MIN_CONFIDENCE=0.8
# Provider secrets stay in the data plane.
# Optional OpenAI-compatible endpoint for a self-hosted review model. Applies to
# an unprefixed deployment name and to the prefixes that name such an endpoint:
# ollama/, ollama_chat/, hosted_vllm/, vllm/, lm_studio/, litellm_proxy/,
# openai_like/, custom_openai/, and openai/ -- the last because it is the
# conventional prefix for an OpenAI-compatible server. It is ignored for every
# provider that reaches its own managed endpoint (anthropic/, openrouter/,
# azure/, vertex_ai/), so pairing a self-hosted model with a managed
# one never sends the managed model's name or credential to the local endpoint.
REVIEW_API_BASE=
REVIEW_STRUCTURED_OUTPUT_MODE=auto
# Which review runtime produces a ReviewReport. `codex` and `claude` are
# CLI-native runners; the configured value is the default and trusted SCM
# provenance can choose its opposite family. Both runner images must be present
# and logged in. `litellm` remains the transitional API mode.
REVIEW_RUNTIME=codex
# The following pass/chunk/verifier knobs apply to the `litellm` runtime only.
REVIEW_PASSES=correctness,security,performance,tests
# How carefully to review: brisk, standard, careful, thorough, or exhaustive.
# This states an intent, not a provider's parameter. Diffuse probes what the
# model you configured actually supports and decides what the intent becomes
# there -- a graded effort level on current anthropic/ and openai/ reasoning
# routes, a thinking-token budget on claude-haiku-4-5 and gemini/, an on/off
# switch on ollama/, and nothing at all on openai/gpt-4.1-mini.
#
# Unset sends nothing and leaves the model on its own default. `thorough` is the
# recommendation -- a missed defect costs far more than the tokens -- but it is
# deliberately not a default, because it changes the bill and the latency of
# every review. Raise REVIEW_MAX_OUTPUT_TOKENS alongside it: thinking tokens are
# billed against it, and it also bounds the thinking budget a route derives.
#
# Whatever the resolution is, Diffuse names it: what you asked for, what the
# model supports, and what will actually be sent. The unhonoured case is written
# to stderr rather than through LOG_LEVEL, which can silence it. A REVIEW_MODEL
# that LiteLLM knows and that cannot express the requested depth at all is a
# refusal to start, not a dropped parameter -- but a model LiteLLM has no
# metadata for is reported instead, because an empty rendering there says
# nothing about the endpoint behind it. Run `diffuse model` to see the
# resolution before you commit to a model.
#
# REVIEW_VERIFIER_MODEL interacts with this. Provenance routing permutes the two
# models per pull request, so an AI-authored change can run its candidate pass
# on the model configured as the verifier. That pair is resolved per review and
# recorded on the review run, since the two models need not support the same
# depth -- the documented cross-family verifier openai/gpt-4.1-mini supports
# none of it.
REVIEW_DEPTH=
# Total output budget per call. Models that think before answering bill those
# tokens here. With REVIEW_DEPTH unset Diffuse sends no thinking configuration
# at all, so a current frontier model thinks adaptively and a budget sized for
# the JSON alone gets spent reasoning and truncates the response. With
# REVIEW_DEPTH set, this also bounds the thinking budget the routes named above
# derive from it. Lower it only for a model you know does not think.
REVIEW_MAX_OUTPUT_TOKENS=16000
REVIEW_MODEL_TIMEOUT_SECONDS=180
# In-call retries for a single model request. A review is REVIEW_PASSES x
# REVIEW_MAX_DIFF_CHUNKS calls plus a verifier, but the queue's unit of retry is
# the whole review: without this, one 429 late in a review discards every pass
# that already succeeded, re-pays for them, and spends one of five attempts.
# LiteLLM retries transient statuses only -- an authentication failure is raised
# immediately and dead-letters the job. 0 restores the previous behaviour.
REVIEW_MODEL_RETRIES=2
# Repository Q&A inherits REVIEW_MODEL unless overridden. Plain code search does
# not call a generation model.
CODE_QUERY_MODEL=
CODE_QUERY_MAX_OUTPUT_TOKENS=1800
CODE_QUERY_MODEL_TIMEOUT_SECONDS=60
REVIEW_DIFF_CHARS_PER_CALL=50000
REVIEW_MAX_DIFF_CHUNKS=8
# Diagram generation budgets. The worker validates all three at startup, so a
# malformed value stops the process rather than dead-lettering each review.
REVIEW_DIAGRAM_DIFF_CHARS=40000
REVIEW_DIAGRAM_CONTEXT_CHARS=16000
REVIEW_DIAGRAM_MAX_OUTPUT_TOKENS=2500
MIN_REVIEW_CONFIDENCE=0.75
SCM_API_TIMEOUT_SECONDS=30
# Pushing to an open pull request re-reviews it (`triggers.review_updates`),
# which costs a model call per push. A pushed revision waits this long before
# the worker may claim it, so a burst -- a fixup, a lint fix, a force-push --
# collapses into one review of the final head. The wait is measured from the
# first push of the burst, so a steady drip cannot defer the review forever.
# 0 reviews every push immediately.
REVIEW_UPDATE_DEBOUNCE_SECONDS=60
WORKFLOW_LEASE_SECONDS=1800
# GitHub has no review-reaction webhook. The worker reconciles reactions on
# durable low-priority jobs at this interval.
FEEDBACK_SYNC_INTERVAL_SECONDS=900
FEEDBACK_SYNC_SCHEDULER_SECONDS=60
FEEDBACK_SYNC_BATCH_SIZE=20
# Feedback-derived rule generation starts only after the repository has enough
# independent history. Suggestions remain inert until an operator approves one.
RULE_LEARNING_MODEL=
RULE_LEARNING_MIN_EVIDENCE=10
RULE_LEARNING_MIN_PULL_REQUESTS=10
RULE_LEARNING_EVALUATION_INTERVAL_SECONDS=3600
RULE_LEARNING_SCHEDULER_SECONDS=300
RULE_LEARNING_BATCH_SIZE=5
RULE_LEARNING_MAX_OUTPUT_TOKENS=5000
RULE_LEARNING_MODEL_TIMEOUT_SECONDS=180
SUGGESTED_RULE_MIN_SUPPORT=3
SUGGESTED_RULE_MIN_SUPPORT_PULL_REQUESTS=3
DIFFUSE_REPOSITORY_ROOT=/var/lib/diffuse/repositories
# Ceiling on the disk one repository may take, applied to the cloned mirror and
# to the working copy before it is materialized. Diffuse shares a host with its
# database, so an unbounded clone would take the database down with it.
DIFFUSE_MAX_REPOSITORY_BYTES=5368709120

# --- Process and diagnostics: read by code, all have working defaults ---
# Uvicorn bind address for `diffuse serve`. Compose publishes 127.0.0.1:8000, so
# the container binds all interfaces and the host binding does the limiting.
DIFFUSE_BIND_HOST=0.0.0.0
DIFFUSE_BIND_PORT=8000
# Target and timeout for `diffuse healthcheck`, which is what the container
# healthcheck runs. It probes /ready, not /health, so a container is only healthy
# once the packaged migration history matches the database.
DIFFUSE_HEALTHCHECK_URL=http://127.0.0.1:8000/ready
DIFFUSE_HEALTHCHECK_TIMEOUT_SECONDS=5
# Python logging level for the worker and API.
LOG_LEVEL=INFO
# Seconds between worker heartbeat lines. The worker has no container
# healthcheck -- process liveness would say nothing about whether it is making
# progress -- so this line, which reports queue depth and jobs completed since
# the last one, is what separates healthy-and-idle from wedged. 0 disables it.
WORKER_HEARTBEAT_SECONDS=300
# Worker identity recorded on every leased job. Defaults to hostname:pid, which
# is usually right; set it when several workers share a hostname and you need to
# tell them apart in the queue.
WORKER_ID=
# Any non-empty value re-raises the original exception instead of printing the
# short actionable message, for attaching a full traceback to a bug report. Set
# it per invocation rather than here; leaving it on makes every CLI failure noisy
# and can print configuration values into a shared terminal.
DIFFUSE_CLI_TRACEBACK=
# Where `diffuse agent login` keeps the agent CLI configuration and credentials
# Diffuse owns, one subdirectory per CLI (claude/, codex/). Defaults to
# ~/.diffuse/agent. This is deliberately not ~/.claude or ~/.codex: Diffuse never
# reads or writes the CLI configuration you use in your own terminal, so the
# sign-in it drives (`claude auth login` / `codex login`) is a second, separate
# one — whatever auth method each vendor's own CLI offers. Must be an absolute
# path. The packaged dual runners set this for operator-run commands; do
# not override it to /tmp or the read-only image rootfs. The API and worker
# never mount this directory and never spawn an agent CLI.
DIFFUSE_AGENT_HOME=

# HMAC key for short-lived agent session capabilities. This belongs only to
# the API and worker environment; the credential-isolated agent-runner presents
# signed capabilities but never receives this key. Generate at least 32 random
# bytes, for example: `openssl rand -base64 48`.
DIFFUSE_AGENT_CAPABILITY_SIGNING_KEY=
# Base64url Ed25519 key pair for worker-to-runner dispatch. The private key is
# mounted only in the worker; Compose passes only the public key to runners.
DIFFUSE_AGENT_DISPATCH_PRIVATE_KEY=
DIFFUSE_AGENT_DISPATCH_PUBLIC_KEY=

# The single authority the self-hosted review compartment's egress proxy allows,
# Per-runner vendor egress allowlists. Keep their defaults unless a vendor's
# documented API hostname changes; runners never share egress or credentials.
DIFFUSE_CLAUDE_MODEL_HOST=api.anthropic.com
DIFFUSE_CODEX_MODEL_HOST=api.openai.com

# --- Internal paths: override only when relocating a packaged install ---
# Absolute path to the migration catalog. The packaged image sets this; a source
# checkout resolves it relative to the repository.
DIFFUSE_SQL_DIR=
# Absolute path to the non-interactive git askpass helper. Diffuse ships one and
# resolves it automatically; overriding it changes how clone credentials reach
# git subprocesses, so leave it unset unless you know why.
DIFFUSE_GIT_ASKPASS=

# --- Non-API-key model credentials, resolved from the ambient environment ---
# Vertex does not authenticate with a single API key, so a REVIEW_MODEL value
# prefixed vertex_ai/ reads Google's own application-default credential chain
# instead.
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
# Legacy alias for OPENAI_API_KEY, accepted by the provider table. Prefer
# OPENAI_API_KEY; this exists so an older .env keeps working.
OPENAI_KEY=
