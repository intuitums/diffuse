# Copy to `.env` for a self-hosted deployment. Values with no default must be
# supplied by the operator; all other values are safe starting points.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://diffuse:diffuse-dev@localhost:5432/diffuse

# Reviews always run through an isolated Agent Host. Select one installed Agent.
REVIEW_AGENT=codex
DIFFUSE_REVIEW_AGENT_CODEX_RUNNER_URL=http://agent-host-codex:8010
DIFFUSE_REVIEW_AGENT_CLAUDE_RUNNER_URL=http://agent-host-claude:8010
DIFFUSE_CLAUDE_RUNNER_IMAGE=
DIFFUSE_CODEX_RUNNER_IMAGE=

# Agent Dispatch (Ed25519) and Review Access Grants (HMAC). Generate each
# independently; do not reuse values across roles.
#
# Dispatch keypair (base64url-encoded 32-byte raw Ed25519 seed / public key):
#   private=$(head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=')
#   # Derive the matching public key with Python, for example:
#   # PRIVATE="$private" python - <<'PY'
#   # import base64, os
#   # from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
#   # from cryptography.hazmat.primitives import serialization
#   # raw = base64.urlsafe_b64decode(os.environ["PRIVATE"] + "==")
#   # pub = Ed25519PrivateKey.from_private_bytes(raw).public_key().public_bytes(
#   #     serialization.Encoding.Raw, serialization.PublicFormat.Raw)
#   # print(base64.urlsafe_b64encode(pub).decode().rstrip("="))
#   # PY
# Capability HMAC signing key (any >=32 byte secret; hex is fine):
#   openssl rand -hex 32
# Transport wrap key (base64url-encoded exactly 32 random bytes — not hex):
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
DIFFUSE_REVIEW_AGENT_DISPATCH_PRIVATE_KEY=
DIFFUSE_REVIEW_AGENT_DISPATCH_PUBLIC_KEY=
DIFFUSE_REVIEW_AGENT_CAPABILITY_SIGNING_KEY=
# Shared by the worker and Agent Hosts; seals the capability bearer inside each
# signed dispatch envelope (base64url exactly 32 random bytes).
DIFFUSE_REVIEW_AGENT_TRANSPORT_SECRET=

# Recommended: connect this instance to the Diffuse GitHub App.
DIFFUSE_GITHUB_INTEGRATION_URL=https://api.diffuse.website
DIFFUSE_GITHUB_INTEGRATION_TOKEN=
DIFFUSE_GITHUB_DELIVERY_SIGNING_KEY=
DIFFUSE_GITHUB_DELIVERY_POLL_SECONDS=15

# Or operate a GitHub App directly. Do not configure both connection modes.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEB_URL=https://github.com
GITHUB_API_URL=https://api.github.com
GITHUB_GRAPHQL_URL=
GITHUB_ALLOWED_INSTANCES=
GITHUB_API_VERSION=2026-03-10

DIFFUSE_ENV_FILE=.env
DIFFUSE_REPOSITORY_ROOT=/var/lib/diffuse/repositories
DIFFUSE_MAX_REPOSITORY_BYTES=5368709120
DIFFUSE_PUBLIC_URL=http://localhost:8000
DIFFUSE_ALLOW_PLAINTEXT_ORIGINS=0
MAX_CONTEXT_CHUNKS=18
MAX_CONTEXT_CHARS=24000
SCM_API_TIMEOUT_SECONDS=30
REVIEW_UPDATE_DEBOUNCE_SECONDS=60
WORKFLOW_LEASE_SECONDS=1800
FEEDBACK_SYNC_INTERVAL_SECONDS=900
FEEDBACK_SYNC_SCHEDULER_SECONDS=60
FEEDBACK_SYNC_BATCH_SIZE=20
# Bounded worker repair for repositories enrolled before immutable GitHub IDs.
GITHUB_IDENTITY_BACKFILL_SECONDS=300
GITHUB_IDENTITY_BACKFILL_BATCH_SIZE=25
