# --- REQUIRED: Compose will not start until these are set ---
# POSTGRES_PASSWORD  - blocks `docker compose up` while empty
# DIFFUSE_API_TOKEN  - bootstrap API/MCP credential
# OPENAI_API_KEY     - required by the default EMBEDDING_MODEL, which is OpenAI
# ANTHROPIC_API_KEY  - required by the default REVIEW_MODEL
# Plus GITHUB_TOKEN and GITHUB_WEBHOOK_SECRET.
# Everything else in this file has a working default.

# Docker Compose database password. Generate a URL-safe value, for example
# `openssl rand -hex 32`. Compose refuses to start while this is empty.
#
# ROTATING THIS IS NOT A CONFIGURATION CHANGE. PostgreSQL reads POSTGRES_PASSWORD
# only when it initialises an empty data directory; on every later start it is
# ignored. But the same value is interpolated into DATABASE_URL, so editing it
# against an existing pgdata volume leaves the stored password untouched and
# breaks authentication for app, worker and migrate at once. To actually rotate:
# change the password inside PostgreSQL first
# (`docker compose exec db psql -U diffuse -c "ALTER ROLE diffuse PASSWORD '...'"`),
# then update this file and restart. Deleting the volume also works and destroys
# every index and review.
POSTGRES_PASSWORD=

# Model providers and source-control integrations
# Required whenever EMBEDDING_MODEL names an OpenAI model, which is the default
# and is the only family whose embedding key Diffuse resolves itself. Any other
# provider must authenticate from the ambient environment inside LiteLLM. This
# stays required even when REVIEW_MODEL points at another provider, and the
# worker now refuses to start without it rather than failing each index job.
OPENAI_API_KEY=
# Required by the default REVIEW_MODEL below: any REVIEW_MODEL starting with
# `anthropic/` or `claude-` resolves this key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# One gateway credential can serve both configured review families. With
# LiteLLM, use model IDs such as openrouter/anthropic/claude-sonnet-4.6.
OPENROUTER_API_KEY=
# A GitHub App installation token or user access token with Contents: read (to
# clone), Pull requests: read/write (to publish), and Checks: write when a
# repository enables status checks. Diffuse does not perform the App
# JWT/installation-token exchange: this is a bearer string you mint and rotate.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Override both URLs together for GitHub Enterprise Server.
GITHUB_WEB_URL=https://github.com
GITHUB_API_URL=https://api.github.com
# Optional exact comma-separated origins that may receive the process-level
# GitHub token during clone/fetch. The primary GITHUB_WEB_URL is always allowed.
GITHUB_ALLOWED_INSTANCES=
# Optional for GitHub Enterprise Server; defaults to the public endpoint or is
# derived from an API URL ending in /api/v3.
GITHUB_GRAPHQL_URL=
GITHUB_API_VERSION=2026-03-10

# Browser sign-in. LEAVE THESE UNSET: the flow is incomplete -- the server-side
# endpoints exist (GET /auth/cli, /auth/github/callback, /setup) but there is no
# `diffuse login` client to complete them and oauth_store.load_session has no
# production caller. When it ships, Diffuse is the confidential OAuth client and
# the client secret is read from a file rather than the environment, so you will
# mount one read-only at mode 600 owned by the service user; the Compose files no
# longer mount a secrets directory because nothing currently reads from it.
# Sign-in stays disabled until GITHUB_OAUTH_CLIENT_ID is set.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET_FILE=/srv/diffuse/secrets/app-client-secret
# GitHub App slug, used to offer an install link after a browser sign-in and to
# carry the state that attributes the installation to a user. Optional.
GITHUB_APP_SLUG=
# Optional TTL overrides. States are single-use and short-lived; sessions are
# revocable and stored only as SHA-256.
DIFFUSE_OAUTH_STATE_TTL_SECONDS=600
DIFFUSE_SESSION_TTL_SECONDS=2592000

# Diffuse
# Compose normally loads this copied file as `.env`. Override only for
# configuration validation or a secret-manager-generated environment file.
DIFFUSE_ENV_FILE=.env
# Used by commands run directly on the host. Replace the password with the
# URL-safe POSTGRES_PASSWORD below. Compose supplies its own container URL.
DATABASE_URL=postgresql://diffuse:diffuse-dev@localhost:5432/diffuse
DIFFUSE_PUBLIC_URL=http://localhost:8000
# Every configured origin receives a token, a clone credential, or the OAuth
# client-secret exchange, so https is required off loopback. Set to 1 only for
# a lab instance where plaintext to a non-loopback host is acceptable.
DIFFUSE_ALLOW_PLAINTEXT_ORIGINS=0
# Bootstrap/recovery credential with installation-wide access. Generate a
# high-entropy value and project it from a deployment secret manager. Use
# `diffuse token add` to provision repository-scoped MCP or REST credentials.
DIFFUSE_API_TOKEN=
# Add the exact external host when exposing MCP through a reverse proxy.
DIFFUSE_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MIN_CONTEXT_SIMILARITY=0.25
# Retrieved repository context budget. The formatted context block is built once
# and then repeated verbatim into every review call, so the prompt-token cost of
# raising these is multiplied by REVIEW_PASSES x REVIEW_MAX_DIFF_CHUNKS: at the
# defaults below that is 4 passes x up to 8 chunks = up to 32 calls carrying
# ~6k context tokens each (~192k tokens); a typical single-chunk pull request
# costs ~24k tokens. Treat both as lower bounds rather than a quote: the
# default model tokenizes the same text into noticeably more tokens than the
# gpt-4.1-mini these figures were measured on, and it bills adaptive thinking
# at output rates. Measure your own repositories before budgeting. Lower
# MAX_CONTEXT_CHARS first if reviews get expensive - it binds before the chunk
# count whenever chunks are large. MAX_CONTEXT_CHUNKS must be 1-20; above 20 the
# fusion stage is already selecting from an exhausted candidate pool. Both are
# validated at startup, so a malformed value fails fast instead of per review.
MAX_CONTEXT_CHUNKS=18
MAX_CONTEXT_CHARS=24000
# Frontier default: strong bug-finding, 1M context to match the retrieval budget
# above, and $3/$15 per million input/output tokens. Roughly 7x the input cost
# of the previous openai/gpt-4.1-mini default per token, which typically lands
# under a dollar per reviewed pull request. Cheaper alternatives, in order:
# anthropic/claude-haiku-4-5 ($1/$5, 200K context), or the previous default
# openai/gpt-4.1-mini (needs only OPENAI_API_KEY). For maximum depth on
# high-stakes repositories use anthropic/claude-opus-4-8 ($5/$25). To keep review
# traffic inside your own infrastructure, set a self-hosted route here (for
# example ollama/<model> or litellm_proxy/<model>) together with REVIEW_API_BASE
# below; a managed `anthropic/` route ignores REVIEW_API_BASE by design.
REVIEW_MODEL=anthropic/claude-sonnet-5
# Optional independent verifier. Configure a different family to let Diffuse
# route Claude-authored changes to OpenAI, OpenAI-authored changes to Claude,
# and ambiguous Cursor/Copilot changes through cross-family verification.
REVIEW_VERIFIER_MODEL=
REVIEW_PROVENANCE_MIN_CONFIDENCE=0.8
# Provider secrets stay in the data plane.
# Optional OpenAI-compatible endpoint for a self-hosted review model. Applies to
# an unprefixed deployment name and to the prefixes that name such an endpoint:
# ollama/, ollama_chat/, hosted_vllm/, vllm/, lm_studio/, litellm_proxy/,
# openai_like/, custom_openai/, and openai/ -- the last because it is the
# conventional prefix for an OpenAI-compatible server. It is ignored for every
# provider that reaches its own managed endpoint (anthropic/, openrouter/,
# bedrock/, azure/, vertex_ai/), so pairing a self-hosted model with a managed
# one never sends the managed model's name or credential to the local endpoint.
REVIEW_API_BASE=
REVIEW_STRUCTURED_OUTPUT_MODE=auto
REVIEW_PASSES=correctness,security,performance,tests
# Total output budget per call. Models that think before answering bill those
# tokens here, and the default REVIEW_MODEL thinks adaptively because Diffuse
# sends no thinking configuration -- so a budget sized for the JSON alone gets
# spent reasoning and truncates the response. Lower it only for a model you
# know does not think.
REVIEW_MAX_OUTPUT_TOKENS=16000
REVIEW_MODEL_TIMEOUT_SECONDS=180
# In-call retries for a single model request. A review is REVIEW_PASSES x
# REVIEW_MAX_DIFF_CHUNKS calls plus a verifier, but the queue's unit of retry is
# the whole review: without this, one 429 late in a review discards every pass
# that already succeeded, re-pays for them, and spends one of five attempts.
# LiteLLM retries transient statuses only -- an authentication failure is raised
# immediately and dead-letters the job. 0 restores the previous behaviour.
REVIEW_MODEL_RETRIES=2
# Repository Q&A inherits REVIEW_MODEL unless overridden. Plain code search does
# not call a generation model.
CODE_QUERY_MODEL=
CODE_QUERY_MAX_OUTPUT_TOKENS=1800
CODE_QUERY_MODEL_TIMEOUT_SECONDS=60
REVIEW_DIFF_CHARS_PER_CALL=50000
REVIEW_MAX_DIFF_CHUNKS=8
MIN_REVIEW_CONFIDENCE=0.75
SCM_API_TIMEOUT_SECONDS=30
WORKFLOW_LEASE_SECONDS=1800
# GitHub has no review-reaction webhook. The worker reconciles reactions on
# durable low-priority jobs at this interval.
FEEDBACK_SYNC_INTERVAL_SECONDS=900
FEEDBACK_SYNC_SCHEDULER_SECONDS=60
FEEDBACK_SYNC_BATCH_SIZE=20
# Feedback-derived rule generation starts only after the repository has enough
# independent history. Suggestions remain inert until an operator approves one.
RULE_LEARNING_MODEL=
RULE_LEARNING_MIN_EVIDENCE=10
RULE_LEARNING_MIN_PULL_REQUESTS=10
RULE_LEARNING_EVALUATION_INTERVAL_SECONDS=3600
RULE_LEARNING_SCHEDULER_SECONDS=300
RULE_LEARNING_BATCH_SIZE=5
RULE_LEARNING_MAX_OUTPUT_TOKENS=5000
RULE_LEARNING_MODEL_TIMEOUT_SECONDS=180
SUGGESTED_RULE_MIN_SUPPORT=3
SUGGESTED_RULE_MIN_SUPPORT_PULL_REQUESTS=3
DIFFUSE_REPOSITORY_ROOT=/var/lib/diffuse/repositories
# Ceiling on the disk one repository may take, applied to the cloned mirror and
# to the working copy before it is materialized. Diffuse shares a host with its
# database, so an unbounded clone would take the database down with it.
DIFFUSE_MAX_REPOSITORY_BYTES=5368709120

# --- Process and diagnostics: read by code, all have working defaults ---
# Uvicorn bind address for `diffuse serve`. Compose publishes 127.0.0.1:8000, so
# the container binds all interfaces and the host binding does the limiting.
DIFFUSE_BIND_HOST=0.0.0.0
DIFFUSE_BIND_PORT=8000
# Target and timeout for `diffuse healthcheck`, which is what the container
# healthcheck runs. It probes /ready, not /health, so a container is only healthy
# once the packaged migration history matches the database.
DIFFUSE_HEALTHCHECK_URL=http://127.0.0.1:8000/ready
DIFFUSE_HEALTHCHECK_TIMEOUT_SECONDS=5
# Python logging level for the worker and API.
LOG_LEVEL=INFO
# Seconds between worker heartbeat lines. The worker has no container
# healthcheck -- process liveness would say nothing about whether it is making
# progress -- so this line, which reports queue depth and jobs completed since
# the last one, is what separates healthy-and-idle from wedged. 0 disables it.
WORKER_HEARTBEAT_SECONDS=300
# Worker identity recorded on every leased job. Defaults to hostname:pid, which
# is usually right; set it when several workers share a hostname and you need to
# tell them apart in the queue.
WORKER_ID=
# Embedding requests per batch during indexing. Lower it if the provider rate
# limits; raising it mostly trades memory for fewer round trips.
EMBEDDING_BATCH_SIZE=100

# --- Internal paths: override only when relocating a packaged install ---
# Absolute path to the migration catalog. The packaged image sets this; a source
# checkout resolves it relative to the repository.
DIFFUSE_SQL_DIR=
# Absolute path to the non-interactive git askpass helper. Diffuse ships one and
# resolves it automatically; overriding it changes how clone credentials reach
# git subprocesses, so leave it unset unless you know why.
DIFFUSE_GIT_ASKPASS=

# --- Non-API-key model credentials, resolved from the ambient environment ---
# Bedrock and Vertex do not authenticate with a single API key, so REVIEW_MODEL
# values prefixed bedrock/ or vertex_ai/ read the provider's own credential chain
# instead. Note boto3 is not a Diffuse runtime dependency, so Bedrock calls fail
# until it is installed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
# Legacy alias for OPENAI_API_KEY, accepted by the provider table and the
# embedding client. Prefer OPENAI_API_KEY; this exists so an older .env keeps
# working.
OPENAI_KEY=
