# Hosted Diffuse Integration Relay. This process receives callbacks and brokers
# credentials; it does not run review workers or store repository source.

DIFFUSE_IMAGE=ghcr.io/intuitumxyz/diffuse@sha256:replace-with-release-digest
DIFFUSE_GATEWAY_ENV_FILE=gateway.env
DIFFUSE_GATEWAY_SECRETS_DIR=/srv/diffuse-gateway/secrets
POSTGRES_IMAGE=pgvector/pgvector:pg17@sha256:d2ef61f42ef767baa5a1475393303cc235bcd92febd9d7014eddb48b41f3bad0
POSTGRES_PASSWORD=

DIFFUSE_PUBLIC_URL=https://integrations.diffuse.example

# Shared GitHub App identity. The gateway selects an installation for each
# authenticated node, so GITHUB_APP_INSTALLATION_ID must remain empty.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/diffuse/github-app.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEB_URL=https://github.com
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10

# GitHub browser authentication that attributes the App installation before
# node pairing. These settings are unrelated to review-model authentication.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET_FILE=/run/secrets/diffuse/github-oauth-client-secret
GITHUB_APP_SLUG=
DIFFUSE_OAUTH_STATE_TTL_SECONDS=600

SCM_API_TIMEOUT_SECONDS=30
DIFFUSE_ALLOW_PLAINTEXT_ORIGINS=0
LOG_LEVEL=INFO
