# Immutable release images supplied by the release bundle.
DIFFUSE_IMAGE=ghcr.io/intuitumxyz/diffuse@sha256:replace-with-release-digest
DIFFUSE_CLAUDE_RUNNER_IMAGE=ghcr.io/intuitumxyz/diffuse-runner-claude@sha256:replace-with-release-digest
DIFFUSE_CODEX_RUNNER_IMAGE=ghcr.io/intuitumxyz/diffuse-runner-codex@sha256:replace-with-release-digest
POSTGRES_IMAGE=pgvector/pgvector:pg17@sha256:d2ef61f42ef767baa5a1475393303cc235bcd92febd9d7014eddb48b41f3bad0

POSTGRES_PASSWORD=
DIFFUSE_PUBLIC_URL=https://diffuse.example.com
REVIEW_AGENT=codex
DIFFUSE_REVIEW_AGENT_CODEX_RUNNER_URL=http://agent-host-codex:8010
DIFFUSE_REVIEW_AGENT_CLAUDE_RUNNER_URL=http://agent-host-claude:8010
# Dispatch keys are base64url-encoded raw Ed25519 bytes (not openssl -hex).
# See .env.example for generation commands.
DIFFUSE_REVIEW_AGENT_DISPATCH_PRIVATE_KEY=
DIFFUSE_REVIEW_AGENT_DISPATCH_PUBLIC_KEY=
DIFFUSE_REVIEW_AGENT_CAPABILITY_SIGNING_KEY=
DIFFUSE_REVIEW_AGENT_TRANSPORT_SECRET=

DIFFUSE_GITHUB_INTEGRATION_URL=https://api.diffuse.website
DIFFUSE_GITHUB_INTEGRATION_TOKEN=
DIFFUSE_GITHUB_DELIVERY_SIGNING_KEY=
DIFFUSE_GITHUB_DELIVERY_POLL_SECONDS=15
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEB_URL=https://github.com
GITHUB_API_URL=https://api.github.com
GITHUB_GRAPHQL_URL=
GITHUB_ALLOWED_INSTANCES=
GITHUB_API_VERSION=2026-03-10

DIFFUSE_ENV_FILE=.env
DIFFUSE_REPOSITORY_ROOT=/var/lib/diffuse/repositories
DIFFUSE_MAX_REPOSITORY_BYTES=5368709120
DIFFUSE_ALLOW_PLAINTEXT_ORIGINS=0
MAX_CONTEXT_CHUNKS=18
MAX_CONTEXT_CHARS=24000
SCM_API_TIMEOUT_SECONDS=30
REVIEW_UPDATE_DEBOUNCE_SECONDS=60
WORKFLOW_LEASE_SECONDS=1800
FEEDBACK_SYNC_INTERVAL_SECONDS=900
FEEDBACK_SYNC_SCHEDULER_SECONDS=60
FEEDBACK_SYNC_BATCH_SIZE=20
GITHUB_IDENTITY_BACKFILL_SECONDS=300
GITHUB_IDENTITY_BACKFILL_BATCH_SIZE=25
